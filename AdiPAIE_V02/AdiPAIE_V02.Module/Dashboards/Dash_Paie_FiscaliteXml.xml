<Dashboard xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.devexpress.com/dashboard/2016/dashboard">
  <Title Text="Paie — IR &amp; TRIMF" />
  <DataSources>
    <!-- DataSource XAF/XPO : objet 'BulletinLigne' -->
    <ObjectDataSource ComponentName="odsBulletinLigne" Name="BulletinLigne" DataSource="AdiPAIE_V02.Module.BusinessObjects.BulletinLigne, AdiPAIE_V02.Module" />
  </DataSources>

  <Parameters>
    <Parameter Name="pAnnee" Description="Année" Type="System.Int32" Value="2025" />
    <Parameter Name="pMois"  Description="Mois"  Type="System.Int32" Value="9"    />
  </Parameters>

  <Items>
    <!-- 1) IRPP par salarié (barres) -->
    <Chart ComponentName="chartIR" Name="IRPP par salarié" DataSource="odsBulletinLigne">
      <FilterString>[Rubrique.Code] = 'IR' And [Bulletin.Annee] = ?pAnnee And [Bulletin.Mois] = ?pMois</FilterString>
      <Arguments>
        <Dimension DataMember="Bulletin.Salarie.FullName" />
      </Arguments>
      <Panes>
        <Pane Name="Pane 1">
          <Series>
            <Simple SeriesType="Bar">
              <Value>
                <Measure DataMember="Montant" SummaryType="Sum" />
              </Value>
            </Simple>
          </Series>
        </Pane>
      </Panes>
      <Legend Visible="true" />
    </Chart>

    <!-- 2) TRIMF par salarié (barres) -->
    <Chart ComponentName="chartTRIMF" Name="TRIMF par salarié" DataSource="odsBulletinLigne">
      <FilterString>[Rubrique.Code] = 'TRIMF' And [Bulletin.Annee] = ?pAnnee And [Bulletin.Mois] = ?pMois</FilterString>
      <Arguments>
        <Dimension DataMember="Bulletin.Salarie.FullName" />
      </Arguments>
      <Panes>
        <Pane Name="Pane 1">
          <Series>
            <Simple SeriesType="Bar">
              <Value>
                <Measure DataMember="Montant" SummaryType="Sum" />
              </Value>
            </Simple>
          </Series>
        </Pane>
      </Panes>
      <Legend Visible="true" />
    </Chart>

    <!-- 3) Détail IR & TRIMF (grid) -->
    <Grid ComponentName="gridDetail" Name="Détail IR &amp; TRIMF" DataSource="odsBulletinLigne">
      <FilterString>
        ([Rubrique.Code] In ('IR','TRIMF')) And [Bulletin.Annee] = ?pAnnee And [Bulletin.Mois] = ?pMois
      </FilterString>
      <Columns>
        <GridDimensionColumn>
          <Dimension DataMember="Bulletin.Salarie.FullName" />
          <WidthType>Weight</WidthType>
          <Weight>25</Weight>
        </GridDimensionColumn>
        <GridDimensionColumn>
          <Dimension DataMember="Rubrique.Code" />
          <WidthType>Weight</WidthType>
          <Weight>12</Weight>
        </GridDimensionColumn>
        <GridMeasureColumn>
          <Measure DataMember="Montant" SummaryType="Sum" />
          <WidthType>Weight</WidthType>
          <Weight>15</Weight>
        </GridMeasureColumn>
        <GridDimensionColumn>
          <Dimension DataMember="Bulletin.Annee" />
          <WidthType>Weight</WidthType>
          <Weight>8</Weight>
        </GridDimensionColumn>
        <GridDimensionColumn>
          <Dimension DataMember="Bulletin.Mois" />
          <WidthType>Weight</WidthType>
          <Weight>8</Weight>
        </GridDimensionColumn>
      </Columns>
      <ShowCaption>true</ShowCaption>
    </Grid>

    <!-- 4) Carte récap (facultative) : IR vs TRIMF par salarié -->
    <Cards ComponentName="cardsSynth" Name="Synthèse IR &amp; TRIMF" DataSource="odsBulletinLigne">
      <FilterString>[Bulletin.Annee] = ?pAnnee And [Bulletin.Mois] = ?pMois And [Rubrique.Code] In ('IR','TRIMF')</FilterString>
      <DataItems>
        <Dimension DataMember="Bulletin.Salarie.FullName" UniqueName="dimEmp" />
        <Measure DataMember="Montant" SummaryType="Sum" UniqueName="msMontant" />
      </DataItems>
      <SeriesDimensions>
        <SeriesDimension UniqueName="dimEmp" />
      </SeriesDimensions>
      <SparklineArgument />
      <CardsLayout TemplateId="Compact" />
    </Cards>
  </Items>

  <LayoutTree>
    <LayoutGroup Orientation="Vertical">
      <LayoutGroup Orientation="Horizontal" Weight="55">
        <LayoutItem DashboardItem="chartIR" Weight="50" />
        <LayoutItem DashboardItem="chartTRIMF" Weight="50" />
      </LayoutGroup>
      <LayoutGroup Orientation="Horizontal" Weight="45">
        <LayoutItem DashboardItem="gridDetail" Weight="65" />
        <LayoutItem DashboardItem="cardsSynth" Weight="35" />
      </LayoutGroup>
    </LayoutGroup>
  </LayoutTree>
</Dashboard>
