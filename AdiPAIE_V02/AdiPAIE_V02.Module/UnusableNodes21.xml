            <LayoutItem Id="BrutFiscalEstime" ViewItem="BrutFiscalEstime" />
            <LayoutItem Id="BrutSocialEstime" ViewItem="BrutSocialEstime" />
            <LayoutItem Id="TotalCotisationsSociales" ViewItem="TotalCotisationsSociales" />
            <LayoutItem Id="TRIMFEstime" ViewItem="TRIMFEstime" />
            <LayoutItem Id="IRPPEstime" ViewItem="IRPPEstime" />
          </LayoutGroup>
          <LayoutGroup Id="LogGroup" Caption="Trace du calcul" ShowCaption="True">
            <LayoutItem Id="DetailCalcul" ViewItem="DetailCalcul" />
          </LayoutGroup>
        </LayoutGroup>
