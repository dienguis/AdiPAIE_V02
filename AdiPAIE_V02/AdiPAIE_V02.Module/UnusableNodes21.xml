          <LayoutGroup Id="HeaderGroup" Caption="Salarié" ShowCaption="True" Direction="Horizontal">
            <LayoutItem Id="Salarie" ViewItem="Salarie" RelativeSize="70" />
            <LayoutItem Id="PartsFiscales" ViewItem="PartsFiscales" RelativeSize="30" />
          </LayoutGroup>
          <LayoutGroup Id="PeriodeGroup" Caption="Période de simulation" ShowCaption="True" Direction="Horizontal">
            <LayoutItem Id="Mois" ViewItem="Mois" RelativeSize="50" />
            <LayoutItem Id="Annee" ViewItem="Annee" RelativeSize="50" />
          </LayoutGroup>
          <LayoutGroup Id="InputGroup" Caption="Objectif" ShowCaption="True">
            <LayoutItem Id="NetCible" ViewItem="NetCible" />
          </LayoutGroup>
          <LayoutGroup Id="ElementsFixesGroup" Caption="Éléments de paie actuels (fixes)" ShowCaption="True" Direction="Vertical">
            <LayoutItem Id="SalaireBase" ViewItem="SalaireBase" />
            <LayoutItem Id="IndemniteLogement" ViewItem="IndemniteLogement" />
            <LayoutItem Id="PrimeAnciennete" ViewItem="PrimeAnciennete" />
