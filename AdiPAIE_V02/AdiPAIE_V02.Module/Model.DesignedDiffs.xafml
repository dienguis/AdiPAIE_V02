    <!-- ╔═══════════════════════════════════════════════════════════════╗
         ║  V1.1 Sprint 1A — Vues Site enrichies                          ║
         ║  XAF auto-génère les onglets pour les XPCollection (Unites,    ║
         ║  ContratsInterim, Salaries) — on n'override QUE le PropertyEditor║
         ║  Type qui n'apparaît pas tout seul si le ModelDifference est figé.║
         ╚═══════════════════════════════════════════════════════════════╝ -->
    <DetailView Id="Site_DetailView">
      <Items>
        <PropertyEditor Id="Type" PropertyName="Type" IsNewNode="True" />
      </Items>
    </DetailView>
    <ListView Id="Site_ListView">
      <Columns>
        <ColumnInfo Id="Type" PropertyName="Type" Index="2" IsNewNode="True" />
      </Columns>
    </ListView>
  </Views>
