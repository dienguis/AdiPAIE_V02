<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <Deterministic>false</Deterministic>
    <AssemblyVersion>1.0.*</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Configurations>Debug;Release;EasyTest</Configurations>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <!-- V1.5.2 — Cleanup warnings :
         - XAF0020 : [NonPersistent] sur propriétés calculées read-only — légitime
         - CA1416  : APIs Windows-only (System.Drawing, DPAPI). App tourne sur IIS Windows.
         - XAF0022 : ShowViewStrategy.ShowView dans wizards multi-popups
                     (DeclarationController). Migration vers e.ShowViewParameters
                     demande refactor des closures Execute. -->
    <NoWarn>$(NoWarn);XAF0020;CA1416;XAF0022</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Model.xafml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Model.xafml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Update="dbconfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.16.0" />
    <PackageReference Include="DevExpress.Drawing.Skia" Version="25.1.10" />
    <PackageReference Include="DevExpress.ExpressApp.Blazor" Version="25.1.10" />
    <PackageReference Include="DevExpress.ExpressApp.CodeAnalysis" Version="25.1.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="DevExpress.ExpressApp.Dashboards.Blazor" Version="25.1.10" />
    <PackageReference Include="DevExpress.ExpressApp.FileAttachment.Blazor" Version="25.1.10" />
    <PackageReference Include="DevExpress.ExpressApp.Notifications.Blazor" Version="25.1.10" />
    <PackageReference Include="DevExpress.ExpressApp.Office.Blazor" Version="25.1.10" />
    <PackageReference Include="DevExpress.ExpressApp.ReportsV2.Blazor" Version="25.1.10" />
    <PackageReference Include="DevExpress.ExpressApp.Scheduler.Blazor" Version="25.1.10" />
    <PackageReference Include="DevExpress.ExpressApp.Security.Xpo" Version="25.1.10" />
    <PackageReference Include="DevExpress.ExpressApp.Validation.Blazor" Version="25.1.10" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.4.1" />
    <PackageReference Include="Microsoft.Graph" Version="5.93.0" />
    
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AdiPAIE_V02.Module\AdiPAIE_V02.Module.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Components\" />
  </ItemGroup>
  <ItemGroup>
    <None Update="UnusableNodes.xml">
      <DependentUpon>Model.xafml</DependentUpon>
    </None>
  </ItemGroup>
</Project>
