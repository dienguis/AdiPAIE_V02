@* =====================================================================
    BudgetVsRealiseDashboard.razor — V1.2.1 (mai 2026)
    URL : /dashboards/budget-vs-realise
    Périmètre : Pilotage stratégique DAF + Direction Générale

    REFONTE annuelle :
      - Plus de tableau mensuel ni de cumul YTD
      - 4 KPI annuels (Budget brut / Réalisé brut / Écart / Écart %)
      - Évolution 5 années glissantes
      - Ventilation par site
   ===================================================================== *@

@page "/dashboards/budget-vs-realise"
@attribute [Authorize]

@using System.Globalization
@using AdiPAIE_V02.Module.BusinessObjects
@using AdiPAIE_V02.Module.BusinessObjects.Budget
@using AdiPAIE_V02.Module.Models.Dashboards
@using AdiPAIE_V02.Module.Services.Dashboards
@using DevExpress.ExpressApp
@using DevExpress.ExpressApp.Blazor.Services

@inject IBudgetVsRealiseDashboardService Service
@inject INonSecuredObjectSpaceFactory ObjectSpaceFactory
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx

<PageTitle>Budget vs Réalisé — Tableaux de Bord RH</PageTitle>

@if (_loading)
{
    <div class="bvr-loading">
        <DxLoadingPanel Text="Chargement…" Visible="true" />
    </div>
}
else if (_errorMessage != null)
{
    <div class="bvr-error">@_errorMessage</div>
}
else if (_data != null)
{
    <header class="bvr-header">
        <div class="bvr-header__title">
            <button class="bvr-back" @onclick="@(() => Nav.NavigateTo("/dashboards"))" title="Retour">
                <i class="bi bi-arrow-left-circle"></i>
            </button>
            <div>
                <div class="bvr-header__perimetre">Pilotage DAF · Tableau N°7 · Vue annuelle</div>
                <h1 class="bvr-header__h1">Budget vs Réalisé Masse Salariale</h1>
            </div>
        </div>

        <div class="bvr-filters">
            <a class="bvr-help" title="Aide ce tableau" href="/help/dashboards/budget-vs-realise.html" target="_blank" rel="noopener">
                <i class="bi bi-question-circle"></i>
            </a>
            <label>
                <span>Année</span>
                <select @bind="_filter.Annee" @bind:after="LoadDataAsync">
                    @foreach (var y in _anneesDispo)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </label>
            <label>
                <span>Site</span>
                <select @bind="_selectedSiteOid" @bind:after="OnSiteChanged">
                    <option value="">Tous</option>
                    @foreach (var s in _sitesDispo)
                    {
                        <option value="@s.Oid">@s.Nom</option>
                    }
                </select>
            </label>
        </div>
    </header>

    @* ── KPI Tiles (annuels) ─────────────────────────────────────── *@
    <section class="bvr-kpis">
        <div class="bvr-kpi bvr-kpi--budget">
            <div class="bvr-kpi__head"><i class="bi bi-bullseye"></i> Budget brut annuel</div>
            <div class="bvr-kpi__value">@FormatFcfa(_data.Kpis.BudgetBrutAnnuel)</div>
            <div class="bvr-kpi__sub">Année @_data.Annee · @_data.Kpis.NbSitesBudgetes site(s) budgété(s)</div>
        </div>

        <div class="bvr-kpi bvr-kpi--realise">
            <div class="bvr-kpi__head"><i class="bi bi-cash-coin"></i> Réalisé brut annuel</div>
            <div class="bvr-kpi__value">@FormatFcfa(_data.Kpis.RealiseBrutAnnuel)</div>
            <div class="bvr-kpi__sub">Σ BrutFiscal des bulletins @_data.Annee</div>
        </div>

        <div class="bvr-kpi @CssEcart(_data.Kpis.Ecart)">
            <div class="bvr-kpi__head"><i class="bi bi-graph-up-arrow"></i> Écart annuel</div>
            <div class="bvr-kpi__value">@FormatEcart(_data.Kpis.Ecart)</div>
            <div class="bvr-kpi__sub">@FormatPct(_data.Kpis.EcartPct)</div>
        </div>

        <div class="bvr-kpi @CssEcart(_data.Kpis.Ecart)">
            <div class="bvr-kpi__head"><i class="bi bi-bar-chart-line"></i> Sites en dépassement</div>
            <div class="bvr-kpi__value">@_data.Kpis.NbSitesEnDepassement</div>
            <div class="bvr-kpi__sub">Au-dessus du seuil de tolérance (5 %)</div>
        </div>
    </section>

    @* ── Évolution 5 années glissantes ────────────────────────────── *@
    <section class="bvr-section">
        <h3 class="bvr-section__title">Évolution sur 5 années glissantes</h3>
        @if (_data.Evolution.Count == 0 || _data.Evolution.All(e => e.Budget == 0 && e.Realise == 0))
        {
            <div class="bvr-empty">Aucun budget ni bulletin sur la période.</div>
        }
        else
        {
            var maxAnnee = _data.Evolution.Count > 0
                ? Math.Max(1m, _data.Evolution.Max(e => Math.Max(e.Budget, e.Realise)))
                : 1m;

            <table class="bvr-table">
                <thead>
                    <tr>
                        <th>Année</th>
                        <th class="num">Budget brut</th>
                        <th class="num">Réalisé brut</th>
                        <th class="num">Écart</th>
                        <th class="num">Écart %</th>
                        <th class="bar">Comparaison</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in _data.Evolution)
                    {
                        var pctB = (decimal)e.Budget * 100m / maxAnnee;
                        var pctR = (decimal)e.Realise * 100m / maxAnnee;
                        var cssRow = e.Annee == _data.Annee ? "bvr-row--current" : "";
                        <tr class="@cssRow">
                            <td><strong>@e.Annee</strong></td>
                            <td class="num">@FormatFcfa(e.Budget)</td>
                            <td class="num">@FormatFcfa(e.Realise)</td>
                            <td class="num @CssEcart(e.Ecart)">@FormatEcart(e.Ecart)</td>
                            <td class="num @CssEcart(e.Ecart)">@FormatPct(e.EcartPct)</td>
                            <td class="bar">
                                <div class="bvr-doublebar">
                                    <div class="bvr-doublebar__b"
                                         style="@($"width:{pctB.ToString("0.00", InvCulture)}%")"
                                         title="@($"Budget : {FormatFcfa(e.Budget)}")"></div>
                                    <div class="bvr-doublebar__r"
                                         style="@($"width:{pctR.ToString("0.00", InvCulture)}%")"
                                         title="@($"Réalisé : {FormatFcfa(e.Realise)}")"></div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="bvr-legend">
                <span><span class="dot dot-budget"></span>Budget</span>
                <span><span class="dot dot-realise"></span>Réalisé</span>
                <span class="bvr-hint">La ligne grasse identifie l'année sélectionnée.</span>
            </div>
        }
    </section>

    @* ── Ventilation par site ────────────────────────────────────── *@
    <section class="bvr-section">
        <h3 class="bvr-section__title">Ventilation par site — Année @_data.Annee</h3>
        @if (_data.ParSite.Count == 0)
        {
            <div class="bvr-empty">Aucun budget saisi pour @_data.Annee. Aller dans Paramétrage → Budget Masse Salariale pour saisir.</div>
        }
        else
        {
            <table class="bvr-table">
                <thead>
                    <tr>
                        <th>Site</th>
                        <th class="num">Budget brut</th>
                        <th class="num">Réalisé brut</th>
                        <th class="num">Écart</th>
                        <th class="num">Écart %</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _data.ParSite)
                    {
                        <tr>
                            <td>@s.SiteNom</td>
                            <td class="num">@FormatFcfa(s.Budget)</td>
                            <td class="num">@FormatFcfa(s.Realise)</td>
                            <td class="num @CssEcart(s.Ecart)">@FormatEcart(s.Ecart)</td>
                            <td class="num @CssEcart(s.Ecart)">@FormatPct(s.EcartPct)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <footer class="bvr-footer">
        <span><i class="bi bi-clock-history"></i> Calculé le @_data.CalculatedAt.ToString("dd/MM/yyyy HH:mm:ss", FrCulture)</span>
        <span class="sep">·</span>
        <span>Année cible : @_data.Annee · Saisie annuelle sur le brut</span>
    </footer>
}

<style>
    :root {
        --bvr-navy: #142E4D;
        --bvr-navy-light: #1F4376;
        --bvr-orange: #F18A1C;
        --bvr-blue: #1A73B5;
        --bvr-red: #E63946;
        --bvr-green: #2EA75B;
        --bvr-text: #142E4D;
        --bvr-soft: #5C6679;
        --bvr-muted: #94A3BC;
        --bvr-bg: #F6F7F9;
        --bvr-border: #E5E7EB;
        --bvr-track: #E5E9EE;
    }

    .bvr-loading, .bvr-error { padding: 2rem; }
    .bvr-error { color: var(--bvr-red); font-weight: 600; }

    .bvr-header {
        background: linear-gradient(135deg, var(--bvr-navy) 0%, var(--bvr-navy-light) 100%);
        color: #E6EAF1;
        padding: 1.1rem 1.5rem;
        display: flex; flex-wrap: wrap; gap: 1.25rem;
        align-items: center; justify-content: space-between;
        border-bottom: 3px solid var(--bvr-orange);
    }
    .bvr-header__title { display: flex; align-items: center; gap: 0.75rem; }
    .bvr-back {
        background: var(--bvr-navy-light); border: none; color: #fff;
        width: 38px; height: 38px; border-radius: 50%;
        font-size: 1.25rem; cursor: pointer;
    }
    .bvr-back:hover { background: var(--bvr-orange); }
    .bvr-header__h1 { font-size: 1.55rem; font-weight: 700; margin: 0; color: #fff; }
    .bvr-header__perimetre {
        font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em;
        color: var(--bvr-orange); font-weight: 600;
    }
    .bvr-filters { display: flex; gap: 0.85rem; flex-wrap: wrap; align-items: flex-end; }
    .bvr-filters label { display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.72rem; }
    .bvr-filters label span { color: #B7C2D5; text-transform: uppercase; letter-spacing: 0.04em; }
    .bvr-filters select {
        padding: 0.35rem 0.55rem; border: 1px solid var(--bvr-navy-light);
        background: rgba(255,255,255,0.08); color: #fff; border-radius: 4px;
        font-size: 0.85rem; min-width: 120px;
    }
    .bvr-filters select option { color: var(--bvr-text); }
    .bvr-help {
        display: inline-flex; align-items: center; justify-content: center;
        width: 36px; height: 36px; border-radius: 50%;
        background: rgba(255,255,255,0.1); color: #fff;
        text-decoration: none; font-size: 1.1rem;
        transition: background 0.15s ease;
    }
    .bvr-help:hover { background: var(--bvr-orange); color: #fff; }

    .bvr-kpis {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 0.85rem; padding: 1rem 1.5rem;
    }
    .bvr-kpi {
        background: #fff; border: 1px solid var(--bvr-border);
        border-radius: 8px; padding: 0.95rem 1.1rem;
        box-shadow: 0 1px 2px rgba(20, 46, 77, 0.04);
        border-left: 4px solid var(--bvr-navy);
    }
    .bvr-kpi--budget { border-left-color: var(--bvr-blue); }
    .bvr-kpi--realise { border-left-color: var(--bvr-orange); }
    .bvr-kpi--ok { border-left-color: var(--bvr-green); }
    .bvr-kpi--ko { border-left-color: var(--bvr-red); }
    .bvr-kpi--neutral { border-left-color: var(--bvr-soft); }
    .bvr-kpi__head {
        font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em;
        color: var(--bvr-soft); font-weight: 600; margin-bottom: 0.4rem;
    }
    .bvr-kpi__head i { margin-right: 0.3rem; }
    .bvr-kpi__value {
        font-size: 1.55rem; font-weight: 700; color: var(--bvr-text);
        font-variant-numeric: tabular-nums;
    }
    .bvr-kpi__sub { font-size: 0.75rem; color: var(--bvr-muted); margin-top: 0.25rem; }

    .bvr-section {
        background: #fff; border: 1px solid var(--bvr-border);
        border-radius: 8px; padding: 1rem 1.25rem 1.1rem;
        margin: 0.85rem 1.5rem;
        box-shadow: 0 1px 2px rgba(20, 46, 77, 0.04);
    }
    .bvr-section__title {
        font-size: 0.95rem; font-weight: 700; color: var(--bvr-text);
        margin: 0 0 0.7rem 0; padding-bottom: 0.45rem;
        border-bottom: 2px solid var(--bvr-orange);
        display: inline-block;
    }

    .bvr-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .bvr-table th, .bvr-table td {
        padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--bvr-border);
        text-align: left; font-variant-numeric: tabular-nums;
    }
    .bvr-table th {
        background: var(--bvr-bg); color: var(--bvr-soft); font-weight: 600;
        text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.04em;
    }
    .bvr-table .num { text-align: right; }
    .bvr-table .bar { width: 28%; }
    .bvr-row--current td {
        background: rgba(241, 138, 28, 0.08);
        font-weight: 600;
    }
    .bvr-row--current td:first-child {
        border-left: 3px solid var(--bvr-orange);
    }

    .ec-pos { color: var(--bvr-red); font-weight: 700; }
    .ec-neg { color: var(--bvr-green); font-weight: 700; }
    .ec-neutral { color: var(--bvr-soft); }

    .bvr-doublebar {
        display: flex; flex-direction: column; gap: 2px;
        background: var(--bvr-track); border-radius: 3px; overflow: hidden;
        height: 18px; padding: 1px 0;
    }
    .bvr-doublebar__b { height: 7px; background: var(--bvr-blue); border-radius: 2px; transition: width 0.3s ease; }
    .bvr-doublebar__r { height: 7px; background: var(--bvr-orange); border-radius: 2px; transition: width 0.3s ease; }

    .bvr-legend {
        margin-top: 0.6rem; font-size: 0.75rem; color: var(--bvr-soft);
        display: flex; gap: 1.25rem; align-items: center; flex-wrap: wrap;
    }
    .bvr-legend .dot {
        display: inline-block; width: 11px; height: 11px;
        border-radius: 2px; margin-right: 0.35rem; vertical-align: middle;
    }
    .bvr-legend .dot-budget { background: var(--bvr-blue); }
    .bvr-legend .dot-realise { background: var(--bvr-orange); }
    .bvr-hint { margin-left: auto; font-style: italic; color: var(--bvr-muted); }

    .bvr-empty { color: var(--bvr-muted); padding: 1rem; font-style: italic; text-align: center; }

    .bvr-footer {
        margin: 1rem 1.5rem; padding: 0.6rem 0; font-size: 0.72rem;
        color: var(--bvr-muted); text-align: center;
    }
    .bvr-footer .sep { margin: 0 0.5rem; opacity: 0.5; }
    .bvr-footer i { margin-right: 0.3rem; }
</style>

@code {
    private static readonly CultureInfo FrCulture = CultureInfo.GetCultureInfo("fr-FR");
    private static readonly CultureInfo InvCulture = CultureInfo.InvariantCulture;

    private bool _loading = true;
    private string? _errorMessage;
    private BudgetVsRealiseDto? _data;

    private BudgetVsRealiseFilterModel _filter = new();
    private List<int> _anneesDispo = new();
    private List<Site> _sitesDispo = new();
    private string _selectedSiteOid = "";

    protected override void OnInitialized()
    {
        if (!DashboardAuthHelper.CanAccessDashboards(HttpCtx, ObjectSpaceFactory))
        {
            Nav.NavigateTo("/LoginPage", forceLoad: true);
            return;
        }
        LoadLookups();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadDataAsync();
    }

    private void LoadLookups()
    {
        try
        {
            using var os = ObjectSpaceFactory.CreateNonSecuredObjectSpace(typeof(Bulletin));

            var annees = os.GetObjectsQuery<Bulletin>().ToList()
                .Select(b => b.Annee).Distinct().ToList();
            annees.Add(DateTime.Today.Year);
            annees.Add(DateTime.Today.Year + 1);
            _anneesDispo = annees.Distinct().OrderByDescending(y => y).ToList();

            _sitesDispo = os.GetObjectsQuery<Site>().ToList().OrderBy(s => s.Nom).ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur chargement référentiels : {ex.Message}";
        }
    }

    private async Task LoadDataAsync()
    {
        _loading = true; _errorMessage = null; StateHasChanged();
        try
        {
            await Task.Run(() =>
            {
                using var os = ObjectSpaceFactory.CreateNonSecuredObjectSpace(typeof(BudgetMasseSalariale));
                _data = Service.GetData(_filter, os);
            });
        }
        catch (Exception ex) { _errorMessage = $"Erreur de calcul : {ex.Message}"; }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task OnSiteChanged()
    {
        _filter.SiteOid = Guid.TryParse(_selectedSiteOid, out var oid) ? oid : null;
        await LoadDataAsync();
    }

    private string FormatFcfa(decimal v) => $"{v.ToString("N0", FrCulture)} FCFA";
    private string FormatEcart(decimal v) => (v >= 0 ? "+" : "") + FormatFcfa(v);
    private string FormatPct(decimal v) => (v >= 0 ? "+" : "") + v.ToString("0.00", FrCulture) + "%";

    private string CssEcart(decimal v) =>
        v > 0  ? "ec-pos" :
        v < 0  ? "ec-neg" :
                 "ec-neutral";
}
