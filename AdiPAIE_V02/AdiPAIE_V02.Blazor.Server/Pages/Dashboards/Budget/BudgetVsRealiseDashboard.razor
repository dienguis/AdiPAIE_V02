@* =====================================================================
    BudgetVsRealiseDashboard.razor — V1.2 Sprint 2
    URL : /dashboards/budget-vs-realise
    Périmètre : Pilotage stratégique DAF + Direction Générale
    Source de données : BudgetMasseSalariale (saisi) vs Bulletin (réalisé)

    Couleurs ELTON Oil :
      - Header navy : #142E4D
      - Orange : #F18A1C
      - Vert (sous-conso) : #2EA75B
      - Rouge (dépassement) : #E63946
   ===================================================================== *@

@page "/dashboards/budget-vs-realise"
@attribute [Authorize]

@using System.Globalization
@using AdiPAIE_V02.Module.BusinessObjects
@using AdiPAIE_V02.Module.BusinessObjects.Budget
@using AdiPAIE_V02.Module.Models.Dashboards
@using AdiPAIE_V02.Module.Services.Dashboards
@using DevExpress.ExpressApp
@using DevExpress.ExpressApp.Blazor.Services

@inject IBudgetVsRealiseDashboardService Service
@inject INonSecuredObjectSpaceFactory ObjectSpaceFactory
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx

<PageTitle>Budget vs Réalisé — Tableaux de Bord RH</PageTitle>

@if (_loading)
{
    <div class="bvr-loading">
        <DxLoadingPanel Text="Chargement…" Visible="true" />
    </div>
}
else if (_errorMessage != null)
{
    <div class="bvr-error">@_errorMessage</div>
}
else if (_data != null)
{
    <header class="bvr-header">
        <div class="bvr-header__title">
            <button class="bvr-back" @onclick="@(() => Nav.NavigateTo("/dashboards"))" title="Retour">
                <i class="bi bi-arrow-left-circle"></i>
            </button>
            <div>
                <div class="bvr-header__perimetre">Pilotage DAF · Tableau N°7</div>
                <h1 class="bvr-header__h1">Budget vs Réalisé Masse Salariale</h1>
            </div>
        </div>

        <div class="bvr-filters">
            <a class="bvr-help" title="Aide ce tableau" href="/help/dashboards/budget-vs-realise.html" target="_blank" rel="noopener">
                <i class="bi bi-question-circle"></i>
            </a>
            <label>
                <span>Année</span>
                <select @bind="_filter.Annee" @bind:after="LoadDataAsync">
                    @foreach (var y in _anneesDispo)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </label>
            <label>
                <span>Site</span>
                <select @bind="_selectedSiteOid" @bind:after="OnSiteChanged">
                    <option value="">Tous</option>
                    @foreach (var s in _sitesDispo)
                    {
                        <option value="@s.Oid">@s.Nom</option>
                    }
                </select>
            </label>
            <label>
                <span>Seuil alerte (%)</span>
                <input type="number" min="0" max="100" step="1"
                       value="@_filter.SeuilAlertePct" @onchange="OnSeuilChanged" />
            </label>
        </div>
    </header>

    @* ── KPI Tiles ────────────────────────────────────────────────── *@
    <section class="bvr-kpis">
        <div class="bvr-kpi bvr-kpi--budget">
            <div class="bvr-kpi__head"><i class="bi bi-bullseye"></i> Budget annuel</div>
            <div class="bvr-kpi__value">@FormatFcfa(_data.Kpis.BudgetAnnuel)</div>
            <div class="bvr-kpi__sub">Année @_data.Annee</div>
        </div>

        <div class="bvr-kpi bvr-kpi--ytd">
            <div class="bvr-kpi__head"><i class="bi bi-cash-coin"></i> Réalisé YTD</div>
            <div class="bvr-kpi__value">@FormatFcfa(_data.Kpis.RealiseYtd)</div>
            <div class="bvr-kpi__sub">Budget YTD : @FormatFcfa(_data.Kpis.BudgetYtd)</div>
        </div>

        <div class="bvr-kpi @CssEcart(_data.Kpis.EcartYtd)">
            <div class="bvr-kpi__head"><i class="bi bi-graph-up-arrow"></i> Écart YTD</div>
            <div class="bvr-kpi__value">@FormatEcart(_data.Kpis.EcartYtd)</div>
            <div class="bvr-kpi__sub">@FormatPct(_data.Kpis.EcartYtdPct)</div>
        </div>

        <div class="bvr-kpi @CssEcart(_data.Kpis.EcartProjection)">
            <div class="bvr-kpi__head"><i class="bi bi-rocket-takeoff"></i> Projection annuelle</div>
            <div class="bvr-kpi__value">@FormatFcfa(_data.Kpis.ProjectionAnnuelle)</div>
            <div class="bvr-kpi__sub">Écart : @FormatEcart(_data.Kpis.EcartProjection) (@FormatPct(_data.Kpis.EcartProjectionPct))</div>
        </div>
    </section>

    @* ── Alertes synthèse ────────────────────────────────────────── *@
    <section class="bvr-alerts">
        @if (_data.Kpis.NombreRubriquesEnDepassement > 0)
        {
            <div class="bvr-alert bvr-alert--warn">
                <i class="bi bi-exclamation-triangle"></i>
                <strong>@_data.Kpis.NombreRubriquesEnDepassement</strong>
                rubrique(s) au-dessus du seuil de @_filter.SeuilAlertePct.ToString("0", FrCulture)%.
            </div>
        }
        @if (_data.Kpis.NombreSitesEnDepassement > 0)
        {
            <div class="bvr-alert bvr-alert--warn">
                <i class="bi bi-geo-alt"></i>
                <strong>@_data.Kpis.NombreSitesEnDepassement</strong>
                site(s) au-dessus du seuil.
            </div>
        }
        @if (_data.Kpis.NombreRubriquesEnDepassement == 0 && _data.Kpis.NombreSitesEnDepassement == 0)
        {
            <div class="bvr-alert bvr-alert--ok">
                <i class="bi bi-check-circle"></i> Tous les indicateurs sont dans les seuils tolérés.
            </div>
        }
    </section>

    @* ── Tableau mensuel ─────────────────────────────────────────── *@
    <section class="bvr-section">
        <h3 class="bvr-section__title">Évolution mensuelle Budget vs Réalisé</h3>
        @{
            var maxMensuel = _data.Mensuel.Count > 0
                ? Math.Max(1m, Math.Max(_data.Mensuel.Max(m => m.Budget), _data.Mensuel.Max(m => m.Realise)))
                : 1m;
        }
        <table class="bvr-table">
            <thead>
                <tr>
                    <th>Mois</th>
                    <th class="num">Budget</th>
                    <th class="num">Réalisé</th>
                    <th class="num">Écart</th>
                    <th class="num">Écart %</th>
                    <th class="bar">Comparaison</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in _data.Mensuel)
                {
                    var pctB = (decimal)m.Budget * 100m / maxMensuel;
                    var pctR = (decimal)m.Realise * 100m / maxMensuel;
                    var cssRow = !m.RealiseDisponible ? "bvr-row--future" : "";
                    <tr class="@cssRow">
                        <td>@m.MoisLibelle</td>
                        <td class="num">@FormatFcfa(m.Budget)</td>
                        <td class="num">
                            @if (m.RealiseDisponible) { @FormatFcfa(m.Realise) }
                            else { <span class="bvr-na">—</span> }
                        </td>
                        <td class="num @CssEcart(m.Ecart)">
                            @if (m.RealiseDisponible) { @FormatEcart(m.Ecart) }
                            else { <span class="bvr-na">—</span> }
                        </td>
                        <td class="num @CssEcart(m.Ecart)">
                            @if (m.RealiseDisponible) { @FormatPct(m.EcartPct) }
                            else { <span class="bvr-na">—</span> }
                        </td>
                        <td class="bar">
                            <div class="bvr-doublebar">
                                <div class="bvr-doublebar__b" style="@($"width:{pctB.ToString("0.00", InvCulture)}%")" title="Budget"></div>
                                @if (m.RealiseDisponible)
                                {
                                    <div class="bvr-doublebar__r" style="@($"width:{pctR.ToString("0.00", InvCulture)}%")" title="Réalisé"></div>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="bvr-legend">
            <span><span class="dot dot-budget"></span>Budget</span>
            <span><span class="dot dot-realise"></span>Réalisé</span>
            <span class="bvr-hint">Lignes grisées = mois sans réalisé encore disponible.</span>
        </div>
    </section>

    @* ── Cumul YTD ───────────────────────────────────────────────── *@
    <section class="bvr-section">
        <h3 class="bvr-section__title">Cumul YTD — Budget vs Réalisé</h3>
        @{
            var maxCumul = _data.CumulYtd.Count > 0
                ? Math.Max(1m, _data.CumulYtd.Max(c => Math.Max(c.BudgetCumule, c.RealiseCumule)))
                : 1m;
        }
        <div class="bvr-cumul">
            @foreach (var c in _data.CumulYtd)
            {
                var pctB = (decimal)c.BudgetCumule * 100m / maxCumul;
                var pctR = (decimal)c.RealiseCumule * 100m / maxCumul;
                <div class="bvr-cumul__row">
                    <div class="bvr-cumul__label">@c.MoisLibelle.Substring(0, Math.Min(3, c.MoisLibelle.Length))</div>
                    <div class="bvr-cumul__bars">
                        <div class="bvr-cumul__b" style="@($"width:{pctB.ToString("0.00", InvCulture)}%")" title="Budget cumulé">
                            <span>@FormatFcfa(c.BudgetCumule)</span>
                        </div>
                        <div class="bvr-cumul__r" style="@($"width:{pctR.ToString("0.00", InvCulture)}%")" title="Réalisé cumulé">
                            <span>@FormatFcfa(c.RealiseCumule)</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    @* ── 2 colonnes : par rubrique + par site ───────────────────── *@
    <div class="bvr-grid">

        <section class="bvr-section">
            <h3 class="bvr-section__title">Décomposition par rubrique</h3>
            @if (_data.ParRubrique.Count == 0)
            {
                <div class="bvr-empty">Aucun budget saisi pour @_data.Annee.</div>
            }
            else
            {
                <table class="bvr-table">
                    <thead>
                        <tr>
                            <th>Rubrique</th>
                            <th class="num">Budget</th>
                            <th class="num">Réalisé*</th>
                            <th class="num">Écart %</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _data.ParRubrique)
                        {
                            <tr>
                                <td>@r.RubriqueLibelle</td>
                                <td class="num">@FormatFcfa(r.Budget)</td>
                                <td class="num">@FormatFcfa(r.Realise)</td>
                                <td class="num @CssEcart(r.Ecart)">@FormatPct(r.EcartPct)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="bvr-note">* Réalisé ventilé au prorata du budget (V1.2). Mapping rubrique réelle prévu V1.3.</div>
            }
        </section>

        <section class="bvr-section">
            <h3 class="bvr-section__title">Écart par site</h3>
            @if (_data.ParSite.Count == 0)
            {
                <div class="bvr-empty">Aucune ventilation site disponible.</div>
            }
            else
            {
                <table class="bvr-table">
                    <thead>
                        <tr>
                            <th>Site</th>
                            <th class="num">Budget</th>
                            <th class="num">Réalisé</th>
                            <th class="num">Écart %</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _data.ParSite)
                        {
                            <tr>
                                <td>@s.SiteNom</td>
                                <td class="num">@FormatFcfa(s.Budget)</td>
                                <td class="num">@FormatFcfa(s.Realise)</td>
                                <td class="num @CssEcart(s.Ecart)">@FormatPct(s.EcartPct)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

    </div>

    <footer class="bvr-footer">
        <span><i class="bi bi-clock-history"></i> Calculé le @_data.CalculatedAt.ToString("dd/MM/yyyy HH:mm:ss", FrCulture)</span>
        <span class="sep">·</span>
        <span>Année @_data.Annee · Mois courant : @(_data.MoisCourant?.ToString("D2") ?? "—")</span>
    </footer>
}

<style>
