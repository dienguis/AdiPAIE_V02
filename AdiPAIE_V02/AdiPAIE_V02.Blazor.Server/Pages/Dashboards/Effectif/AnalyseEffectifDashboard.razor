    private static string FormatAns(decimal ans) =>
        $"{Math.Round(ans, 0, MidpointRounding.AwayFromZero).ToString("0", FrCulture)} ans";

    private static string FormatPct(decimal pct) =>
        $"{pct.ToString("0.0", FrCulture)}%";
