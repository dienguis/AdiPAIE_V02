@code {
    private static readonly CultureInfo FrCulture = CultureInfo.GetCultureInfo("fr-FR");
    private static readonly CultureInfo InvCulture = CultureInfo.InvariantCulture;

    private bool _loading = true;
    private string? _errorMessage;
    private SuiviAbsencesDto? _data;
    private SuiviAbsencesFilterModel _filter = new();

    private List<int> _anneesDispo = new();
    private List<Site> _sitesDispo = new();
    private List<Categories> _categoriesDispo = new();
    private List<string> _departementsDispo = new();
    private MotifAbsence[] _motifsDispo = new[]
    {
        MotifAbsence.AUT, MotifAbsence.NAUT, MotifAbsence.EVENT, MotifAbsence.MAL, MotifAbsence.AT,
        MotifAbsence.CPAYE, MotifAbsence.FORM, MotifAbsence.MAT, MotifAbsence.PAT
    };

    private List<string> _filtersSummary = new();

    protected override void OnInitialized()
    {
        if (!DashboardAuthHelper.CanAccessDashboards(HttpCtx, ObjectSpaceFactory))
        {
            Nav.NavigateTo("/LoginPage", forceLoad: true);
            return;
        }
        LoadLookups();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadDataAsync();
    }

    private void LoadLookups()
    {
        try
        {
            using var os = ObjectSpaceFactory.CreateNonSecuredObjectSpace(typeof(Salarie));
            _anneesDispo = Enumerable.Range(DateTime.Today.Year - 3, 5).OrderByDescending(y => y).ToList();
            _sitesDispo = os.GetObjectsQuery<Site>().ToList().OrderBy(s => s.Nom).ToList();
            _categoriesDispo = os.GetObjectsQuery<Categories>().ToList()
                .OrderBy(c => c.Intitule ?? "").ToList();

            // Distinct des Departement.Nom via réflection
            var sals = os.GetObjectsQuery<Salarie>().ToList();
            var depts = sals
                .Select(s =>
                {
                    try
                    {
                        var prop = typeof(Salarie).GetProperty("Departement");
                        if (prop == null) return null;
                        var dep = prop.GetValue(s);
                        return dep?.GetType().GetProperty("Nom")?.GetValue(dep)?.ToString();
                    }
                    catch { return null; }
                })
                .Where(d => !string.IsNullOrWhiteSpace(d))
                .Distinct()
                .OrderBy(d => d)
                .Cast<string>()
                .ToList();
            _departementsDispo = depts;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur chargement référentiels : {ex.Message}";
        }
    }

    private async Task LoadDataAsync()
    {
        // Vider les données précédentes pour un feedback visuel immédiat
        // (sinon l'utilisateur voit les anciennes valeurs pendant le calcul)
        _data = null;
        _loading = true; _errorMessage = null; StateHasChanged();
        try
        {
            BuildFiltersSummary();
            await Task.Run(() =>
            {
                using var os = ObjectSpaceFactory.CreateNonSecuredObjectSpace(typeof(Salarie));
                _data = Service.GetData(_filter, os);
            });
        }
        catch (Exception ex) { _errorMessage = $"Erreur de calcul : {ex.Message}"; }
        finally { _loading = false; StateHasChanged(); }
    }

    private void BuildFiltersSummary()
    {
        _filtersSummary.Clear();
        if (_filter.Annees.Count > 0) _filtersSummary.Add($"{string.Join(",", _filter.Annees)}");
        if (_filter.Mois.Count > 0) _filtersSummary.Add($"{_filter.Mois.Count} mois");
        if (_filter.SiteOids.Count > 0) _filtersSummary.Add($"{_filter.SiteOids.Count} sites");
        if (_filter.GenreSet.Count > 0) _filtersSummary.Add(string.Join("/", _filter.GenreSet));
        if (_filter.CategorieOids.Count > 0) _filtersSummary.Add($"{_filter.CategorieOids.Count} cat.");
        if (_filter.DepartementsNoms.Count > 0) _filtersSummary.Add($"{_filter.DepartementsNoms.Count} dépt.");
        if (_filter.MotifsActifs.Count > 0) _filtersSummary.Add($"{_filter.MotifsActifs.Count} motifs");
    }

    // ── Toggles filtres ────────────────────────────────────────────
    private async Task ToggleAnnee(int y)
    {
        if (_filter.Annees.Contains(y)) _filter.Annees.Remove(y);
        else _filter.Annees.Add(y);
        if (_filter.Annees.Count == 0) _filter.Annees.Add(DateTime.Today.Year);
        await LoadDataAsync();
    }
    private async Task ToggleMois(int m)
    {
        if (_filter.Mois.Contains(m)) _filter.Mois.Remove(m);
        else _filter.Mois.Add(m);
        await LoadDataAsync();
    }
    private async Task ToggleSite(Guid oid)
    {
        if (_filter.SiteOids.Contains(oid)) _filter.SiteOids.Remove(oid);
        else _filter.SiteOids.Add(oid);
        await LoadDataAsync();
    }

    private async Task ClearSites()
    {
        _filter.SiteOids.Clear();
        await LoadDataAsync();
    }

    private string _siteSearch = "";

    /// <summary>Sites filtrés par la recherche en cours (case-insensitive sur Nom).</summary>
    private List<Site> FilteredSites
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_siteSearch)) return _sitesDispo;
            var q = _siteSearch.Trim().ToUpperInvariant();
            return _sitesDispo.Where(s => (s.Nom ?? "").ToUpperInvariant().Contains(q)).ToList();
        }
    }
    private async Task ToggleGenre(Sexe g)
    {
        if (_filter.GenreSet.Contains(g)) _filter.GenreSet.Remove(g);
        else _filter.GenreSet.Add(g);
        await LoadDataAsync();
    }
    private async Task ToggleCategorie(Guid oid)
    {
        if (_filter.CategorieOids.Contains(oid)) _filter.CategorieOids.Remove(oid);
        else _filter.CategorieOids.Add(oid);
        await LoadDataAsync();
    }
    private async Task ToggleDept(string d)
    {
        if (_filter.DepartementsNoms.Contains(d)) _filter.DepartementsNoms.Remove(d);
        else _filter.DepartementsNoms.Add(d);
        await LoadDataAsync();
    }
    private async Task ToggleMotif(MotifAbsence m)
    {
        if (_filter.MotifsActifs.Contains(m)) _filter.MotifsActifs.Remove(m);
        else _filter.MotifsActifs.Add(m);
        await LoadDataAsync();
    }
    private async Task ResetFilters()
    {
        var current = _filter.Personnel;
        _filter = new SuiviAbsencesFilterModel { Personnel = current };
        await LoadDataAsync();
    }

    private async Task SwitchVue(VueAbsences v)
    {
        if (_filter.Vue == v) return;
        _filter.Vue = v;
        await LoadDataAsync();
    }

    private async Task PrevMonth()
    {
        _filter.MoisCalendrier--;
        if (_filter.MoisCalendrier < 1) { _filter.MoisCalendrier = 12; _filter.AnneeCalendrier--; }
        await LoadDataAsync();
    }

    private async Task NextMonth()
    {
        _filter.MoisCalendrier++;
        if (_filter.MoisCalendrier > 12) { _filter.MoisCalendrier = 1; _filter.AnneeCalendrier++; }
        await LoadDataAsync();
    }

    private async Task CurrentMonth()
    {
        _filter.MoisCalendrier = DateTime.Today.Month;
        _filter.AnneeCalendrier = DateTime.Today.Year;
        await LoadDataAsync();
    }

    private static string CssCellMotif(MotifAbsence m) => m switch
    {
        MotifAbsence.MAL   => "sa-cal-cell--mal",
        MotifAbsence.AT    => "sa-cal-cell--at",
        MotifAbsence.EVENT => "sa-cal-cell--event",
        MotifAbsence.AUT or MotifAbsence.NAUT => "sa-cal-cell--aut",
        MotifAbsence.CPAYE => "sa-cal-cell--cpaye",
        MotifAbsence.FORM  => "sa-cal-cell--form",
        MotifAbsence.MAT or MotifAbsence.PAT => "sa-cal-cell--mat",
        _                  => "sa-cal-cell--autre"
    };

    private async Task SwitchPersonnel(PersonnelType p)
    {
        if (_filter.Personnel == p) return;
        _filter.Personnel = p;
        // Vider les filtres qui n'ont pas de sens dans le périmètre cible
        if (p == PersonnelType.Externe)
        {
            // Externe : Catégorie, Département, Genre n'ont pas de sens
            _filter.GenreSet.Clear();
            _filter.DepartementsNoms.Clear();
            _filter.CategorieOids.Clear();
        }
        else
        {
            // Interne : Site n'est pas une dimension d'analyse pertinente (les
            // salariés internes sont au siège, le site n'apporte pas d'info)
            _filter.SiteOids.Clear();
        }
        // Reset Motifs aussi (les motifs disponibles dépendent du périmètre)
        _filter.MotifsActifs.Clear();
        await LoadDataAsync();
    }

    // ── Helpers display ────────────────────────────────────────────
    private string FmtJ(decimal v) => v == 0m ? "" : v.ToString("0", FrCulture);
    private string CssRespTmp(decimal v) =>
        v >= 95m ? "resp-ok" : v >= 90m ? "resp-warn" : "resp-bad";

    private static bool IsAbsenteismeMotif(MotifAbsence m) =>
        m == MotifAbsence.AUT || m == MotifAbsence.NAUT
        || m == MotifAbsence.EVENT || m == MotifAbsence.MAL
        || m == MotifAbsence.AT;
}
