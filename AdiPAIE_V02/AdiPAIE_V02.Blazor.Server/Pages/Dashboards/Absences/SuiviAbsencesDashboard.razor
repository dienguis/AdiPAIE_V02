@* =====================================================================
    SuiviAbsencesDashboard.razor — Tableau N°5 V1.3.2 (mai 2026)
    URL : /dashboards/suivi-absences
    Périmètre : Personnel INTERNE (Salarie + CongeDemande)

    REFONTE Excel-style (alignée sur SUIVI ABSENCES 2026 ELTON) :
      - 6 KPIs : Effectif Moyen, se sont Absentés, Total jours,
                 Absentéisme %, JO Perdus, Resp. Tmp Travail %
      - Filtres multi : Année, Site, Mois, Catégorie, Département, Genre, Motif
      - Décomposition fine : 10 motifs (5 Absentéisme + 4 Programmées + Autre)
      - Tableaux : Par Motif / Par Ancienneté / Par Catégorie / Par Département
      - Évolution mensuelle 2 séries (Absentéisme + Programmées)
      - Liste détaillée employés avec décomposition par motif (10 colonnes)
   ===================================================================== *@

@page "/dashboards/suivi-absences"
@attribute [Authorize]

@using System.Globalization
@using AdiPAIE_V02.Module.BusinessObjects
@using AdiPAIE_V02.Module.Models.Dashboards
@using AdiPAIE_V02.Module.Services.Dashboards
@using DevExpress.ExpressApp
@using DevExpress.ExpressApp.Blazor.Services
@using static AdiPAIE_V02.Module.Domain.DomainEnums

@inject ISuiviAbsencesDashboardService Service
@inject INonSecuredObjectSpaceFactory ObjectSpaceFactory
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx

<PageTitle>Suivi des Absences — Tableaux de Bord RH</PageTitle>

@if (_loading)
{
    <div class="sa-loading"><DxLoadingPanel Text="Calcul des absences…" Visible="true" /></div>
}
else if (_errorMessage != null)
{
    <div class="sa-error">@_errorMessage</div>
}
else if (_data != null)
{
    <header class="sa-header">
        <div class="sa-header__title">
            <button class="sa-back" @onclick="@(() => Nav.NavigateTo("/dashboards"))" title="Retour">
                <i class="bi bi-arrow-left-circle"></i>
            </button>
            <div>
                <div class="sa-header__perimetre">
                    Tableau N°5 · @(_filter.Personnel == PersonnelType.Externe ? "Personnel Externe (Intérimaires)" : "Personnel Interne") · V1.3.2
                </div>
                <h1 class="sa-header__h1">Suivi des Absences</h1>
            </div>
        </div>

        @* Toggle Interne / Externe *@
        <div class="sa-toggle">
            <button type="button"
                    class="sa-toggle__btn @(_filter.Personnel == PersonnelType.Interne ? "sa-toggle__btn--on" : "")"
                    @onclick="@(() => SwitchPersonnel(PersonnelType.Interne))">
                <i class="bi bi-people-fill"></i> Interne
            </button>
            <button type="button"
                    class="sa-toggle__btn @(_filter.Personnel == PersonnelType.Externe ? "sa-toggle__btn--on" : "")"
                    @onclick="@(() => SwitchPersonnel(PersonnelType.Externe))">
                <i class="bi bi-person-badge"></i> Externe (Intérimaires)
            </button>
        </div>

        @* Toggle Vue Tableau / Calendrier (uniquement Interne — Externe n'a pas de granularité jour) *@
        @if (_filter.Personnel == PersonnelType.Interne)
        {
            <div class="sa-toggle">
                <button type="button"
                        class="sa-toggle__btn @(_filter.Vue == VueAbsences.Tableau ? "sa-toggle__btn--on" : "")"
                        @onclick="@(() => SwitchVue(VueAbsences.Tableau))">
                    <i class="bi bi-table"></i> Tableau
                </button>
                <button type="button"
                        class="sa-toggle__btn @(_filter.Vue == VueAbsences.Calendrier ? "sa-toggle__btn--on" : "")"
                        @onclick="@(() => SwitchVue(VueAbsences.Calendrier))">
                    <i class="bi bi-calendar3"></i> Calendrier
                </button>
            </div>
        }

        <a class="sa-help" title="Aide" href="/help/dashboards/suivi-absences.html" target="_blank" rel="noopener">
            <i class="bi bi-question-circle"></i>
        </a>
    </header>

    @if (_filter.Personnel == PersonnelType.Externe)
    {
        <div class="sa-banner-externe">
            <i class="bi bi-info-circle"></i>
            <strong>Mode Externe (Intérimaires)</strong> — données calculées à partir du
            <em>30ème de présence</em> des bulletins intérim importés. Pas de décomposition fine
            par motif (le fichier facture ne contient pas le détail). Les filtres Catégorie /
            Département / Genre / Ancienneté ne s'appliquent pas à ce périmètre.
        </div>
    }

    @* ── Bandeau filtres (toolbar collapsible) ─────────────────────── *@
    <section class="sa-filters">
        <details open>
            <summary><strong>Filtres</strong> @if (_filtersSummary.Count > 0) { <span class="sa-tag">@string.Join(" · ", _filtersSummary)</span> }</summary>
            <div class="sa-filters__grid">

                @* Années (multi) *@
                <div class="sa-filter">
                    <label>Année(s)</label>
                    <div class="sa-chips">
                        @foreach (var y in _anneesDispo)
                        {
                            var on = _filter.Annees.Contains(y);
                            <button type="button" class="sa-chip @(on ? "sa-chip--on" : "")"
                                    @onclick="@(() => ToggleAnnee(y))">@y</button>
                        }
                    </div>
                </div>

                @* Mois (multi) *@
                <div class="sa-filter">
                    <label>Mois</label>
                    <div class="sa-chips">
                        @for (int m = 1; m <= 12; m++)
                        {
                            var mm = m;
                            var on = _filter.Mois.Contains(mm);
                            <button type="button" class="sa-chip sa-chip--mini @(on ? "sa-chip--on" : "")"
                                    @onclick="@(() => ToggleMois(mm))">@mm.ToString("D2")</button>
                        }
                        <button type="button" class="sa-chip sa-chip--reset"
                                @onclick="@(() => { _filter.Mois.Clear(); _ = LoadDataAsync(); })">Tous</button>
                    </div>
                </div>

                @* Site (multi) — EXTERNE uniquement (intérimaires affectés aux stations) *@
                @if (_filter.Personnel == PersonnelType.Externe)
                {
                    <div class="sa-filter sa-filter--wide">
                        <label>
                            Site(s)
                            @if (_filter.SiteOids.Count > 0)
                            {
                                <span class="sa-tag">@_filter.SiteOids.Count sélectionné(s)</span>
                            }
                        </label>
                        @if (_sitesDispo.Count <= 8)
                        {
                            <div class="sa-chips">
                                @foreach (var s in _sitesDispo)
                                {
                                    var sOid = s.Oid;
                                    var on = _filter.SiteOids.Contains(sOid);
                                    <button type="button" class="sa-chip @(on ? "sa-chip--on" : "")"
                                            @onclick="@(() => ToggleSite(sOid))">@s.Nom</button>
                                }
                            </div>
                        }
                        else
                        {
                            <details class="sa-sitesdrop">
                                <summary class="sa-sitesdrop__btn">
                                    <i class="bi bi-geo-alt"></i>
                                    @(_filter.SiteOids.Count == 0
                                        ? "Choisir parmi " + _sitesDispo.Count + " sites…"
                                        : _filter.SiteOids.Count + " site(s) sélectionné(s)")
                                    <i class="bi bi-chevron-down sa-sitesdrop__caret"></i>
                                </summary>
                                <div class="sa-sitesdrop__panel">
                                    <input type="search" placeholder="🔍 Rechercher un site…"
                                           class="sa-sitesdrop__search"
                                           @bind="_siteSearch" @bind:event="oninput" />
                                    <div class="sa-sitesdrop__actions">
                                        <button type="button" class="sa-btn-mini" @onclick="ClearSites">Tout désélectionner</button>
                                        <span class="sa-sitesdrop__count">@FilteredSites.Count / @_sitesDispo.Count</span>
                                    </div>
                                    <div class="sa-sitesdrop__list">
                                        @foreach (var s in FilteredSites)
                                        {
                                            var sOid = s.Oid;
                                            var on = _filter.SiteOids.Contains(sOid);
                                            <label class="sa-sitesdrop__item @(on ? "sa-sitesdrop__item--on" : "")">
                                                <input type="checkbox" checked="@on"
                                                       @onclick="@(() => ToggleSite(sOid))" />
                                                <span>@s.Nom</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            </details>
                        }
                    </div>
                }

                @* Genre / Catégorie / Département — INTERNE uniquement *@
                @if (_filter.Personnel == PersonnelType.Interne)
                {
                    <div class="sa-filter">
                        <label>Genre</label>
                        <div class="sa-chips">
                            <button type="button" class="sa-chip @(_filter.GenreSet.Contains(Sexe.Masculin) ? "sa-chip--on" : "")"
                                    @onclick="@(() => ToggleGenre(Sexe.Masculin))">♂ Hommes</button>
                            <button type="button" class="sa-chip @(_filter.GenreSet.Contains(Sexe.Feminin) ? "sa-chip--on" : "")"
                                    @onclick="@(() => ToggleGenre(Sexe.Feminin))">♀ Femmes</button>
                        </div>
                    </div>

                    <div class="sa-filter">
                        <label>Catégorie(s)</label>
                        <div class="sa-chips">
                            @foreach (var c in _categoriesDispo)
                            {
                                var cOid = c.Oid;
                                var on = _filter.CategorieOids.Contains(cOid);
                                <button type="button" class="sa-chip @(on ? "sa-chip--on" : "")"
                                        @onclick="@(() => ToggleCategorie(cOid))">@(c.Intitule ?? "?")</button>
                            }
                        </div>
                    </div>

                    <div class="sa-filter">
                        <label>Département(s)</label>
                        <div class="sa-chips">
                            @foreach (var d in _departementsDispo)
                            {
                                var on = _filter.DepartementsNoms.Contains(d);
                                <button type="button" class="sa-chip @(on ? "sa-chip--on" : "")"
                                        @onclick="@(() => ToggleDept(d))">@d</button>
                            }
                        </div>
                    </div>
                }

                @* Motif *@
                <div class="sa-filter">
                    <label>Motif(s)</label>
                    <div class="sa-chips">
                        @foreach (var m in _motifsDispo)
                        {
                            var on = _filter.MotifsActifs.Contains(m);
                            var css = IsAbsenteismeMotif(m) ? "sa-chip--abs" : "sa-chip--prog";
                            <button type="button" class="sa-chip @css @(on ? "sa-chip--on" : "")"
                                    @onclick="@(() => ToggleMotif(m))">@m</button>
                        }
                    </div>
                </div>

                <div class="sa-filter sa-filter__reset">
                    <button class="sa-btn sa-btn--reset" @onclick="ResetFilters">
                        <i class="bi bi-arrow-counterclockwise"></i> Réinitialiser
                    </button>
                </div>

            </div>
        </details>
    </section>

    @* ═══════════════════════════════════════════════════════════════
       VUE CALENDRIER (uniquement si Interne + Vue=Calendrier)
       ═══════════════════════════════════════════════════════════════ *@
    @if (_filter.Personnel == PersonnelType.Interne && _filter.Vue == VueAbsences.Calendrier && _data.Calendrier != null)
    {
        <section class="sa-cal-toolbar">
            <div class="sa-cal-period">
                <button class="sa-cal-nav" @onclick="PrevMonth" title="Mois précédent">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <div class="sa-cal-period__lbl">
                    <strong>@_data.Calendrier.MoisLibelle @_data.Calendrier.Annee</strong>
                </div>
                <button class="sa-cal-nav" @onclick="NextMonth" title="Mois suivant">
                    <i class="bi bi-chevron-right"></i>
                </button>
                <button class="sa-cal-today" @onclick="CurrentMonth">Aujourd'hui</button>
            </div>
            <div class="sa-cal-legend">
                <span class="legend-cell legend-mal">MAL</span>
                <span class="legend-cell legend-at">AT</span>
                <span class="legend-cell legend-event">EVENT</span>
                <span class="legend-cell legend-aut">AUT/NAUT</span>
                <span class="legend-cell legend-cpaye">CPAYE</span>
                <span class="legend-cell legend-form">FORM</span>
                <span class="legend-cell legend-mat">MAT/PAT</span>
                <span class="legend-cell legend-we">Weekend</span>
            </div>
        </section>

        <section class="sa-section">
            @if (_data.Calendrier.Lignes.Count == 0)
            {
                <div class="sa-empty-cal">
                    <i class="bi bi-calendar-x"></i>
                    Aucune absence enregistrée pour @_data.Calendrier.MoisLibelle @_data.Calendrier.Annee.
                </div>
            }
            else
            {
                <div class="sa-cal-wrap">
                    <table class="sa-cal-table">
                        <thead>
                            <tr>
                                <th class="sa-cal-emp">Employé</th>
                                @foreach (var j in _data.Calendrier.Jours)
                                {
                                    <th class="sa-cal-day @(j.IsWeekend ? "sa-cal-day--we" : "")"
                                        title="@j.Date.ToString("dddd dd MMM yyyy", FrCulture)">
                                        <div class="sa-cal-day__num">@j.Jour</div>
                                        <div class="sa-cal-day__lt">@j.LettreJour</div>
                                    </th>
                                }
                                <th class="sa-cal-total">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ligne in _data.Calendrier.Lignes)
                            {
                                <tr>
                                    <td class="sa-cal-emp">
                                        <strong>@ligne.NomComplet</strong>
                                        <small class="sa-mat">@ligne.Matricule · @ligne.Categorie</small>
                                    </td>
                                    @foreach (var j in _data.Calendrier.Jours)
                                    {
                                        var motif = ligne.Cellules.TryGetValue(j.Jour, out var m) ? m : null;
                                        var css = motif.HasValue ? CssCellMotif(motif.Value)
                                                : (j.IsWeekend ? "sa-cal-cell--we" : "");
                                        <td class="sa-cal-cell @css"
                                            title="@(motif.HasValue ? motif.ToString() : (j.IsWeekend ? "Weekend" : ""))">
                                            @(motif.HasValue ? motif.ToString() : "")
                                        </td>
                                    }
                                    <td class="sa-cal-total">@ligne.TotalJours.ToString("0", FrCulture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="sa-hint">@_data.Calendrier.Lignes.Count employé(s) avec au moins 1 absence sur le mois (les salariés sans absence ne sont pas affichés).</div>
            }
        </section>
    }
    else
    {

    @* ═══════════════════════════════════════════════════════════════
       VUE TABLEAU ANALYTIQUE (par défaut)
       ═══════════════════════════════════════════════════════════════ *@

    @* ── 6 KPIs Excel-style ─────────────────────────────────────── *@
    <section class="sa-kpis">
        <div class="sa-kpi sa-kpi--effectif">
            <div class="sa-kpi__head">Effectif Moyen</div>
            <div class="sa-kpi__value">@_data.Kpis.EffectifMoyen.ToString("0", FrCulture)</div>
        </div>
        <div class="sa-kpi sa-kpi--absent">
            <div class="sa-kpi__head">se sont Absentés</div>
            <div class="sa-kpi__value">@_data.Kpis.NbSalariesAbsents</div>
        </div>
        <div class="sa-kpi sa-kpi--jours">
            <div class="sa-kpi__head">Absences (jours)</div>
            <div class="sa-kpi__value">@_data.Kpis.TotalJours.ToString("0.0", FrCulture)</div>
        </div>
        <div class="sa-kpi sa-kpi--taux">
            <div class="sa-kpi__head">Absentéisme</div>
            <div class="sa-kpi__value">@_data.Kpis.TauxAbsenteismePct.ToString("0.0", FrCulture)%</div>
        </div>
        <div class="sa-kpi sa-kpi--jp">
            <div class="sa-kpi__head">JO Perdus</div>
            <div class="sa-kpi__value">@_data.Kpis.JOPerdus.ToString("0.0", FrCulture) j</div>
        </div>
        <div class="sa-kpi sa-kpi--rt">
            <div class="sa-kpi__head">Resp. Tmp Travail</div>
            <div class="sa-kpi__value">@_data.Kpis.RespTempsTravailPct.ToString("0.0", FrCulture)%</div>
            <div class="sa-kpi__flag">@(_data.Kpis.RespTempsTravailPct >= 95 ? "🟢" : (_data.Kpis.RespTempsTravailPct >= 90 ? "🟠" : "🔴"))</div>
        </div>
    </section>

    @* ── Évolution mensuelle (graphique barres) ─────────────────── *@
    <section class="sa-section">
        <h3 class="sa-section__title">Évolution mensuelle (Absentéisme + Programmées)</h3>
        @{
            var maxMois = _data.ParMois.Count > 0
                ? Math.Max(1m, _data.ParMois.Max(m => Math.Max(m.JoursAbsenteisme, m.JoursProgrammees)))
                : 1m;
        }
        <div class="sa-monthbars">
            @foreach (var m in _data.ParMois)
            {
                var hAbs = (decimal)m.JoursAbsenteisme * 120m / maxMois;
                var hProg = (decimal)m.JoursProgrammees * 120m / maxMois;
                <div class="sa-monthcol">
                    <div class="sa-monthcol__bars">
                        <div class="sa-monthcol__abs" style="@($"height:{hAbs.ToString("0.00", InvCulture)}px")" title="@($"Absentéisme : {m.JoursAbsenteisme:0.0} j")"></div>
                        <div class="sa-monthcol__prog" style="@($"height:{hProg.ToString("0.00", InvCulture)}px")" title="@($"Programmées : {m.JoursProgrammees:0.0} j")"></div>
                    </div>
                    <div class="sa-monthcol__lbl">@m.Libelle</div>
                </div>
            }
        </div>
        <div class="sa-legend">
            <span><span class="dot dot-abs"></span>Absentéisme</span>
            <span><span class="dot dot-prog"></span>Programmées</span>
        </div>
    </section>

    @* ── Tableaux côte à côte : Motif (toujours) + 3 dimensions INTERNE seulement ── *@
    <div class="sa-grid4">

        <section class="sa-section">
            <h3 class="sa-section__title">Par Motif</h3>
            <table class="sa-table">
                <thead><tr><th>Motif</th><th class="num">Jours</th><th class="num">% Total</th></tr></thead>
                <tbody>
                    @foreach (var r in _data.ParMotif)
                    {
                        <tr>
                            <td>
                                <span class="sa-tag-motif @(r.IsAbsenteisme ? "sa-tag-motif--abs" : "sa-tag-motif--prog")">@r.Code</span>
                                @r.Libelle
                            </td>
                            <td class="num">@r.NbJours.ToString("0.0", FrCulture)</td>
                            <td class="num">
                                @r.PourcentageDuTotal.ToString("0.0", FrCulture)%
                                <span class="sa-microbar"><span style="@($"width:{r.PourcentageDuTotal.ToString("0.00", InvCulture)}%")"></span></span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        @if (_filter.Personnel == PersonnelType.Interne)
        {
            <section class="sa-section">
                <h3 class="sa-section__title">Par Catégorie</h3>
                <table class="sa-table">
                    <thead><tr><th>Catégorie</th><th class="num">JO Perdus</th><th class="num">Absentéisme</th></tr></thead>
                    <tbody>
                        @foreach (var r in _data.ParCategorie.Take(10))
                        {
                            <tr>
                                <td>@r.Libelle</td>
                                <td class="num">@r.JOPerdus.ToString("0.0", FrCulture)</td>
                                <td class="num">@r.TauxAbsenteismePct.ToString("0.0", FrCulture)%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>

            <section class="sa-section">
                <h3 class="sa-section__title">Par Département</h3>
                <table class="sa-table">
                    <thead><tr><th>Département</th><th class="num">JO Perdus</th><th class="num">Absentéisme</th></tr></thead>
                    <tbody>
                        @foreach (var r in _data.ParDepartement.Take(10))
                        {
                            <tr>
                                <td>@r.Libelle</td>
                                <td class="num">@r.JOPerdus.ToString("0.0", FrCulture)</td>
                                <td class="num">@r.TauxAbsenteismePct.ToString("0.0", FrCulture)%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>

            <section class="sa-section">
                <h3 class="sa-section__title">Par Ancienneté</h3>
                <table class="sa-table">
                    <thead><tr><th>Tranche</th><th class="num">JO Perdus</th><th class="num">Absentéisme</th></tr></thead>
                    <tbody>
                        @foreach (var r in _data.ParAnciennete)
                        {
                            <tr>
                                <td>@r.Tranche ans · @r.NbSalariesActifs sal.</td>
                                <td class="num">@r.JOPerdus.ToString("0.0", FrCulture)</td>
                                <td class="num">@r.TauxAbsenteismePct.ToString("0.0", FrCulture)%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

    </div>

    @* ── Liste détaillée employés ─────────────────────────────── *@
    <section class="sa-section">
        <h3 class="sa-section__title">Détail par employé (décomposition par motif)</h3>
        <div class="sa-tablewrap">
            <table class="sa-table sa-table--detail">
                <thead>
                    <tr>
                        <th rowspan="2">Employé</th>
                        <th rowspan="2">Site</th>
                        <th rowspan="2">Dépt</th>
                        <th rowspan="2">Cat.</th>
                        <th rowspan="2" class="num">Anc.</th>
                        <th colspan="3" class="grp grp-abs">Absences</th>
                        <th rowspan="2" class="num">Resp Tmp</th>
                        <th colspan="5" class="grp grp-abs">Absentéisme (jours)</th>
                        <th colspan="4" class="grp grp-prog">Programmées (jours)</th>
                    </tr>
                    <tr>
                        <th class="num">Abs.</th>
                        <th class="num">Prog.</th>
                        <th class="num">Total</th>
                        <th class="num">AUT</th><th class="num">NAUT</th><th class="num">EVENT</th>
                        <th class="num">MAL</th><th class="num">AT</th>
                        <th class="num">CPAYE</th><th class="num">FORM</th>
                        <th class="num">MAT</th><th class="num">PAT</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in _data.Employes.Where(x => x.TotalJours > 0).Take(100))
                    {
                        <tr>
                            <td><strong>@e.NomComplet</strong> <small class="sa-mat">@e.Matricule</small></td>
                            <td>@e.Site</td>
                            <td>@e.Departement</td>
                            <td>@e.Categorie</td>
                            <td class="num">@e.AncienneteAnnees.ToString("0", FrCulture)</td>
                            <td class="num">@FmtJ(e.JoursAbsenteisme)</td>
                            <td class="num">@FmtJ(e.JoursProgrammees)</td>
                            <td class="num strong">@FmtJ(e.TotalJours)</td>
                            <td class="num">
                                <span class="@CssRespTmp(e.RespTempsTravailPct)">@e.RespTempsTravailPct.ToString("0.0", FrCulture)%</span>
                            </td>
                            <td class="num">@FmtJ(e.JoursAUT)</td>
                            <td class="num">@FmtJ(e.JoursNAUT)</td>
                            <td class="num">@FmtJ(e.JoursEVENT)</td>
                            <td class="num">@FmtJ(e.JoursMAL)</td>
                            <td class="num">@FmtJ(e.JoursAT)</td>
                            <td class="num">@FmtJ(e.JoursCPAYE)</td>
                            <td class="num">@FmtJ(e.JoursFORM)</td>
                            <td class="num">@FmtJ(e.JoursMAT)</td>
                            <td class="num">@FmtJ(e.JoursPAT)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_data.Employes.Count(x => x.TotalJours > 0) > 100)
        {
            <div class="sa-hint">Affichage limité aux 100 premiers (par TotalJours décroissant). Total: @_data.Employes.Count(x => x.TotalJours > 0) employés ayant des absences.</div>
        }
    </section>

    } @* fin else (Vue Tableau analytique) *@

    <footer class="sa-footer">
        <span><i class="bi bi-clock-history"></i> Calculé le @_data.CalculatedAt.ToString("dd/MM/yyyy HH:mm:ss", FrCulture)</span>
        <span class="sep">·</span>
        <span>Mois pic absentéisme : @(_data.Kpis.MoisPicLibelle ?? "—") · Top absent : @(_data.Kpis.TopAbsent ?? "—") (@_data.Kpis.TopAbsentJours.ToString("0.0", FrCulture) j)</span>
    </footer>
}

