    }
    .cri-decomp__pct { color: var(--cri-muted); font-weight: 500; font-size: 0.75rem; }

    .cri-evol { display: flex; flex-direction: column; gap: 0.4rem; }
    .cri-evol__row { display: grid; grid-template-columns: 90px 1fr 130px; gap: 0.5rem; align-items: center; padding: 0.2rem 0.4rem; border-radius: 3px; }
    .cri-evol__row--current { background: rgba(241, 138, 28, 0.1); border-left: 3px solid var(--cri-orange); }
    .cri-evol__lbl { font-size: 0.78rem; color: var(--cri-soft); font-weight: 600; }
    .cri-evol__bar-wrap { background: var(--cri-track); border-radius: 3px; height: 18px; overflow: hidden; }
    .cri-evol__bar { height: 18px; background: var(--cri-orange); transition: width 0.35s ease; }
    .cri-evol__val { font-size: 0.78rem; text-align: right; font-weight: 700; color: var(--cri-text); font-variant-numeric: tabular-nums; }

    .cri-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .cri-table th, .cri-table td {
        padding: 0.45rem 0.65rem; border-bottom: 1px solid var(--cri-border);
        text-align: left; font-variant-numeric: tabular-nums;
    }
    .cri-table th {
        background: var(--cri-bg); color: var(--cri-soft); font-weight: 600;
        text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.04em;
    }
    .cri-table .num { text-align: right; }
    .cri-table .strong { font-weight: 700; color: var(--cri-text); }
    .cri-tablewrap { max-height: 480px; overflow-y: auto; border: 1px solid var(--cri-border); border-radius: 6px; }

    .cri-tag-prest {
        display: inline-block; padding: 0.1rem 0.35rem; border-radius: 3px;
        font-size: 0.65rem; font-weight: 700; background: #E8F1FB; color: var(--cri-blue);
        margin-left: 0.35rem; text-transform: uppercase;
    }
    .cri-tag-warn {
        display: inline-block; padding: 0.1rem 0.35rem; border-radius: 3px;
        font-size: 0.65rem; font-weight: 700; background: #FEF3E2; color: #8A4F00;
        text-transform: uppercase;
    }
    .ec-pos { color: var(--cri-red); font-weight: 700; }
    .ec-neg { color: var(--cri-green); font-weight: 700; }
    .ec-neutral { color: var(--cri-soft); }

    .cri-empty { color: var(--cri-muted); padding: 1rem; font-style: italic; text-align: center; }

    .cri-footer {
        margin: 1rem 1.5rem; padding: 0.6rem 0; font-size: 0.72rem;
        color: var(--cri-muted); text-align: center;
    }
    .cri-footer .sep { margin: 0 0.5rem; opacity: 0.5; }
</style>

@code {
    private static readonly CultureInfo FrCulture = CultureInfo.GetCultureInfo("fr-FR");
    private static readonly CultureInfo InvCulture = CultureInfo.InvariantCulture;

    private bool _loading = true;
    private string? _errorMessage;
    private CoutReelInterimDto? _data;

    private CoutReelInterimFilterModel _filter = new();
    private List<int> _anneesDispo = new();
    private List<Site> _sitesDispo = new();
    private List<SocieteInterim> _societesDispo = new();
    private string _selectedSiteOid = "";
    private string _selectedSocOid = "";
    private string _moisStr = DateTime.Today.Month.ToString();

    protected override void OnInitialized()
    {
        if (!DashboardAuthHelper.CanAccessDashboards(HttpCtx, ObjectSpaceFactory))
        {
            Nav.NavigateTo("/LoginPage", forceLoad: true);
            return;
        }
        LoadLookups();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadDataAsync();
    }

    private void LoadLookups()
    {
        try
        {
            using var os = ObjectSpaceFactory.CreateNonSecuredObjectSpace(typeof(Site));
            _anneesDispo = Enumerable.Range(DateTime.Today.Year - 4, 6).OrderByDescending(y => y).ToList();
            _sitesDispo = os.GetObjectsQuery<Site>().ToList().OrderBy(s => s.Nom).ToList();
            _societesDispo = os.GetObjectsQuery<SocieteInterim>().ToList().OrderBy(s => s.RaisonSociale).ToList();
        }
        catch (Exception ex) { _errorMessage = $"Erreur chargement référentiels : {ex.Message}"; }
    }

    private async Task LoadDataAsync()
    {
        _loading = true; _errorMessage = null; StateHasChanged();
        try
        {
            await Task.Run(() =>
            {
                using var os = ObjectSpaceFactory.CreateNonSecuredObjectSpace(typeof(Site));
                _data = Service.GetData(_filter, os);
            });
        }
        catch (Exception ex) { _errorMessage = $"Erreur de calcul : {ex.Message}"; }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task OnMoisChanged()
    {
        if (int.TryParse(_moisStr, out var m)) _filter.Mois = m;
        await LoadDataAsync();
    }

    private async Task OnSiteChanged()
    {
        _filter.SiteOid = Guid.TryParse(_selectedSiteOid, out var oid) ? oid : null;
        await LoadDataAsync();
    }

    private async Task OnSocChanged()
    {
        _filter.SocieteInterimOid = Guid.TryParse(_selectedSocOid, out var oid) ? oid : null;
        await LoadDataAsync();
    }

    private string FormatFcfa(decimal v) => $"{v.ToString("N0", FrCulture)} FCFA";
    private string FormatEcart(decimal v) => (v >= 0 ? "+" : "") + FormatFcfa(v);
    private string FormatPct(decimal v) => (v >= 0 ? "+" : "") + v.ToString("0.00", FrCulture) + "%";
    private string CssEcart(decimal v) =>
        v > 0 ? "ec-pos" :
        v < 0 ? "ec-neg" :
                "ec-neutral";
}
