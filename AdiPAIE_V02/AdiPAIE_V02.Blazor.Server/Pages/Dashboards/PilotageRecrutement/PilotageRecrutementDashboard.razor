@code {
#nullable enable
    private bool _loading = true;
    private string? _errorMessage;
    private PilotageRecrutementDto? _data;
    private PilotageRecrutementFilterModel _filter = new();

    private List<int> _annees = new();
    private List<Site> _sites = new();
    private List<Categories> _categories = new();

    // Recherche dans le dropdown sites (>8)
    private string _siteSearch = "";
    private List<Site> FilteredSites =>
        string.IsNullOrWhiteSpace(_siteSearch)
            ? _sites
            : _sites.Where(s => (s.Nom ?? "").Contains(_siteSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    private async Task ClearSites()
    {
        _filter.SiteOids.Clear();
        await LoadDataAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadFiltersAsync();
        await LoadDataAsync();
    }

    private Task LoadFiltersAsync()
    {
        try
        {
            using var os = ObjectSpaceFactory.CreateNonSecuredObjectSpace(typeof(PosteVacant));
            _annees = Service.GetAnneesDisponibles(os);
            _sites = Service.GetSitesActifs(os);
            _categories = Service.GetCategories(os);

            if (_annees.Count > 0 && !_annees.Contains(_filter.Annee))
                _filter.Annee = _annees.First();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur chargement filtres : {ex.Message}";
        }
        return Task.CompletedTask;
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _data = null;
        _errorMessage = null;
        StateHasChanged();
        await Task.Yield();
        try
        {
            using var os = ObjectSpaceFactory.CreateNonSecuredObjectSpace(typeof(PosteVacant));
            _data = Service.GetData(_filter, os);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur calcul dashboard : {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshAsync()
    {
        Service.InvalidateCache();
        await LoadDataAsync();
    }

    /// <summary>Switch Interne ⇄ Externe : reset les filtres non pertinents pour le nouveau mode.</summary>
    private async Task SwitchPersonnel(PersonnelType target)
    {
        if (_filter.Personnel == target) return;

        _filter.Personnel = target;

        // Reset systématique des filtres au changement de mode (le contexte change)
        _filter.SiteOids.Clear();
        _filter.DepartementOids.Clear();
        _filter.CategorieOids.Clear();
        _filter.TypeContrat = "";

        // On vide aussi les KPIs pour signaler visuellement le changement
        _data = null;
        Service.InvalidateCache();
        await LoadDataAsync();
    }

    private async Task ToggleSite(Guid oid)
    {
        if (_filter.SiteOids.Contains(oid)) _filter.SiteOids.Remove(oid);
        else _filter.SiteOids.Add(oid);
        await LoadDataAsync();
    }

    private async Task ToggleCategorie(Guid oid)
    {
        if (_filter.CategorieOids.Contains(oid)) _filter.CategorieOids.Remove(oid);
        else _filter.CategorieOids.Add(oid);
        await LoadDataAsync();
    }

    private static string FmtNum(decimal d) =>
        d.ToString("N1", CultureInfo.GetCultureInfo("fr-FR"));

    private static string FmtPct(decimal d) =>
        d.ToString("N1", CultureInfo.GetCultureInfo("fr-FR")) + " %";

    private static string FmtFcfa(decimal d) =>
        d.ToString("N0", CultureInfo.GetCultureInfo("fr-FR")) + " FCFA";
}
