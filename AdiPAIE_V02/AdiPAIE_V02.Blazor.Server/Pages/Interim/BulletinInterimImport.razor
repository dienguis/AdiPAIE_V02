@code {
    private static readonly CultureInfo FrCulture = CultureInfo.GetCultureInfo("fr-FR");

    private int _step = 1;
    private string? _errorMessage;

    // Étape 1 : sélection
    private int _annee = DateTime.Today.Year;
    private int _mois = DateTime.Today.Month;
    private string _societeOidStr = "";
    private List<int> _anneesDispo = new();
    private List<SocieteInterim> _societesDispo = new();

    // Étape 2 : upload
    private bool _uploading = false;
    private byte[]? _fileBytes;
    private string _fileName = "";

    // Étape 3 : preview
    private ImportPreviewDto? _preview;
    private bool _ecraserBatch = false;

    // Étape 4 : résultat
    private ImportResultDto? _result;

    protected override void OnInitialized()
    {
        if (!DashboardAuthHelper.CanAccessDashboards(HttpCtx, ObjectSpaceFactory))
        {
            Nav.NavigateTo("/LoginPage", forceLoad: true);
            return;
        }
        LoadLookups();
    }

    private void LoadLookups()
    {
        try
        {
            using var os = ObjectSpaceFactory.CreateNonSecuredObjectSpace(typeof(SocieteInterim));
            _anneesDispo = Enumerable.Range(DateTime.Today.Year - 5, 7).ToList();
            _societesDispo = os.GetObjectsQuery<SocieteInterim>().ToList()
                .OrderBy(s => s.RaisonSociale).ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur chargement référentiels : {ex.Message}";
        }
    }

    private void GoToStep2()
    {
        _errorMessage = null;
        if (string.IsNullOrEmpty(_societeOidStr))
        {
            _errorMessage = "Choisir une société d'intérim émettrice.";
            return;
        }
        _step = 2;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        _uploading = true;
        StateHasChanged();
        try
        {
            const long MaxSize = 10 * 1024 * 1024; // 10 MB
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(MaxSize).CopyToAsync(ms);
            _fileBytes = ms.ToArray();
            _fileName = e.File.Name;

            if (!Guid.TryParse(_societeOidStr, out var societeOid))
            {
                _errorMessage = "Société invalide.";
                _uploading = false;
                return;
            }

            // Parse via le service
            await Task.Run(() =>
            {
                using var os = ObjectSpaceFactory.CreateNonSecuredObjectSpace(typeof(BulletinInterim));
                _preview = ImportService.Preview(_fileBytes, _fileName, _annee, _mois, societeOid, os);
            });

            _step = 3;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur lors de l'analyse : {ex.Message}";
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private async Task GoToStep4()
    {
        if (_preview == null) return;
        _errorMessage = null;
        try
        {
            await Task.Run(() =>
            {
                using var os = ObjectSpaceFactory.CreateNonSecuredObjectSpace(typeof(BulletinInterim));
                var userName = HttpCtx?.HttpContext?.User?.Identity?.Name ?? "(?)";
                _result = ImportService.Commit(_preview, userName, _ecraserBatch, os);
            });
            _step = 4;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur lors du commit : {ex.Message}";
        }
        StateHasChanged();
    }

    private void ResetWizard()
    {
        _step = 1;
        _preview = null;
        _result = null;
        _fileBytes = null;
        _fileName = "";
        _ecraserBatch = false;
        _errorMessage = null;
    }

    private string FormatFcfa(decimal v) => $"{v.ToString("N0", FrCulture)} FCFA";

    private MarkupString StatutBadge(LignePreviewStatut s) => new(s switch
    {
        LignePreviewStatut.OK => "<span class=\"bii-statut bii-statut--ok\">OK</span>",
        LignePreviewStatut.ACreer => "<span class=\"bii-statut bii-statut--acreer\">À créer</span>",
        LignePreviewStatut.Prestataire => "<span class=\"bii-statut bii-statut--prest\">Prestataire</span>",
        _ => "<span class=\"bii-statut\">Erreur</span>"
    });
}
