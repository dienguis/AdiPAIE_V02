@* =====================================================================
    BulletinInterimImport.razor — V1.3 Sprint 1 (mai 2026)
    URL : /interim/import-livre-paie

    Wizard 4 étapes pour importer le fichier "Livre de Paie Intérim"
    envoyé chaque mois par les sociétés d'intérim.
      Étape 1 : Année / Mois / Société émettrice
      Étape 2 : Upload du fichier .xlsx
      Étape 3 : Preview du résultat (lignes parsées + totaux)
      Étape 4 : Confirmation + commit + rapport
   ===================================================================== *@

@page "/interim/import-livre-paie"
@attribute [Authorize]

@using System.Globalization
@using System.IO
@using System.Linq
@using AdiPAIE_V02.Module.BusinessObjects.Interim
@using AdiPAIE_V02.Module.BusinessObjects.RH
@using AdiPAIE_V02.Module.Models.Interim
@using AdiPAIE_V02.Module.Services.Interim
@using DevExpress.ExpressApp
@using DevExpress.ExpressApp.Blazor.Services
@using Microsoft.AspNetCore.Components.Forms

@inject IBulletinInterimImportService ImportService
@inject INonSecuredObjectSpaceFactory ObjectSpaceFactory
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx

<PageTitle>Import Livre de Paie Intérim</PageTitle>

<div class="bii-container">

    @* ── Header ─────────────────────────────────────────────────── *@
    <header class="bii-header">
        <button class="bii-back" @onclick="@(() => Nav.NavigateTo("/"))" title="Retour">
            <i class="bi bi-arrow-left-circle"></i>
        </button>
        <div>
            <div class="bii-header__perimetre">Intérimaires · V1.3 · Wizard d'import</div>
            <h1 class="bii-header__h1">Charger le Livre de Paie Intérim</h1>
        </div>
        <a class="bii-help" title="Aide" href="/help/import-livre-paie-interim.html" target="_blank" rel="noopener">
            <i class="bi bi-question-circle"></i>
        </a>
    </header>

    @* ── Stepper ────────────────────────────────────────────────── *@
    <div class="bii-stepper">
        <div class="bii-step @(_step >= 1 ? "active" : "") @(_step > 1 ? "done" : "")">
            <span class="bii-step__num">1</span>
            <span class="bii-step__lbl">Période + Société</span>
        </div>
        <div class="bii-step @(_step >= 2 ? "active" : "") @(_step > 2 ? "done" : "")">
            <span class="bii-step__num">2</span>
            <span class="bii-step__lbl">Upload fichier</span>
        </div>
        <div class="bii-step @(_step >= 3 ? "active" : "") @(_step > 3 ? "done" : "")">
            <span class="bii-step__num">3</span>
            <span class="bii-step__lbl">Preview</span>
        </div>
        <div class="bii-step @(_step >= 4 ? "active" : "")">
            <span class="bii-step__num">4</span>
            <span class="bii-step__lbl">Confirmation</span>
        </div>
    </div>

    @if (_errorMessage != null)
    {
        <div class="bii-alert bii-alert--error">
            <i class="bi bi-exclamation-triangle"></i> @_errorMessage
        </div>
    }

    @* ─────────────────────────────────────────────────────────────
       ÉTAPE 1 — Période + Société
       ───────────────────────────────────────────────────────────── *@
    @if (_step == 1)
    {
        <section class="bii-section">
            <h3 class="bii-section__title">Étape 1 — Sélection de la période et de la société d'intérim</h3>

            <div class="bii-form">
                <label>
                    <span>Année</span>
                    <select @bind="_annee">
                        @foreach (var y in _anneesDispo)
                        {
                            <option value="@y">@y</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Mois</span>
                    <select @bind="_mois">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">@m.ToString("D2") — @FrCulture.DateTimeFormat.GetMonthName(m)</option>
                        }
                    </select>
                </label>
                <label class="bii-form__societe">
                    <span>Société d'intérim émettrice</span>
                    <select @bind="_societeOidStr">
                        <option value="">— Choisir —</option>
                        @foreach (var s in _societesDispo)
                        {
                            <option value="@s.Oid">@s.RaisonSociale</option>
                        }
                    </select>
                </label>
            </div>

            <div class="bii-actions">
                <button class="bii-btn bii-btn--primary" @onclick="GoToStep2" disabled="@(string.IsNullOrEmpty(_societeOidStr))">
                    Suivant <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </section>
    }

    @* ─────────────────────────────────────────────────────────────
       ÉTAPE 2 — Upload du fichier
       ───────────────────────────────────────────────────────────── *@
    @if (_step == 2)
    {
        <section class="bii-section">
            <h3 class="bii-section__title">Étape 2 — Upload du fichier Excel</h3>

            <div class="bii-recap">
                <strong>Période :</strong> @_mois.ToString("D2")/@_annee
                · <strong>Société :</strong> @(_societesDispo.FirstOrDefault(s => s.Oid.ToString() == _societeOidStr)?.RaisonSociale ?? "?")
            </div>

            <div class="bii-upload">
                <p>
                    <i class="bi bi-info-circle"></i>
                    Sélectionner le fichier <code>.xlsx</code> envoyé par la société d'intérim.
                    Le système parse le contenu et affiche un preview avant de rien enregistrer.
                </p>

                <InputFile OnChange="OnFileSelected" accept=".xlsx" class="bii-inputfile" />

                @if (_uploading)
                {
                    <div class="bii-uploading">
                        <i class="bi bi-arrow-repeat bii-spin"></i> Analyse du fichier en cours…
                    </div>
                }
            </div>

            <div class="bii-actions">
                <button class="bii-btn bii-btn--secondary" @onclick="@(() => _step = 1)">
                    <i class="bi bi-arrow-left"></i> Précédent
                </button>
            </div>
        </section>
    }

    @* ─────────────────────────────────────────────────────────────
       ÉTAPE 3 — Preview du résultat
       ───────────────────────────────────────────────────────────── *@
    @if (_step == 3 && _preview != null)
    {
        <section class="bii-section">
            <h3 class="bii-section__title">Étape 3 — Preview du résultat (avant commit)</h3>

            <div class="bii-recap">
                <strong>Période :</strong> @_preview.Mois.ToString("D2")/@_preview.Annee
                · <strong>Société :</strong> @_preview.SocieteNom
                · <strong>Fichier :</strong> @_preview.FichierSource
            </div>

            @if (_preview.Erreurs.Count > 0)
            {
                <div class="bii-alert bii-alert--error">
                    <strong>Erreurs détectées :</strong>
                    <ul>
                        @foreach (var er in _preview.Erreurs) { <li>@er</li> }
                    </ul>
                </div>
            }

            @if (_preview.Warnings.Count > 0)
            {
                <div class="bii-alert bii-alert--warn">
                    <strong>Avertissements :</strong>
                    <ul>
                        @foreach (var w in _preview.Warnings) { <li>@w</li> }
                    </ul>
                </div>
            }

            @* Compteurs *@
            <div class="bii-counters">
                <div class="bii-counter bii-counter--ok">
                    <div class="bii-counter__nb">@_preview.NbLignesOk</div>
                    <div class="bii-counter__lbl">Bulletins OK<br/><small>(matricule existant)</small></div>
                </div>
                <div class="bii-counter bii-counter--warn">
                    <div class="bii-counter__nb">@_preview.NbLignesACreer</div>
                    <div class="bii-counter__lbl">Fiches à créer auto<br/><small>(matricule inconnu)</small></div>
                </div>
                <div class="bii-counter bii-counter--info">
                    <div class="bii-counter__nb">@_preview.NbLignesPrestataire</div>
                    <div class="bii-counter__lbl">Prestataires<br/><small>(hors fiche)</small></div>
                </div>
                <div class="bii-counter bii-counter--total">
                    <div class="bii-counter__nb">@_preview.NbLignesTotal</div>
                    <div class="bii-counter__lbl">Total lignes</div>
                </div>
            </div>

            @* Totaux financiers *@
            <h4 class="bii-h4">Totaux financiers du lot</h4>
            <table class="bii-table">
                <tr><td>Total brut imposable</td><td class="num">@FormatFcfa(_preview.TotalBrutImposable)</td></tr>
                <tr><td>Total débours</td><td class="num">@FormatFcfa(_preview.TotalDebours)</td></tr>
                <tr><td>Total commission agence</td><td class="num">@FormatFcfa(_preview.TotalCommissionAgence)</td></tr>
                <tr><td>Total HT</td><td class="num">@FormatFcfa(_preview.TotalHT)</td></tr>
                <tr><td>Total TVA</td><td class="num">@FormatFcfa(_preview.TotalTVA)</td></tr>
                <tr class="bii-row--strong"><td><strong>Total TTC (coût réel ELTON)</strong></td><td class="num"><strong>@FormatFcfa(_preview.TotalTTC)</strong></td></tr>
                <tr><td>Multiplicateur Brut → TTC</td><td class="num">×@_preview.MultiplicateurBrutTTC.ToString("0.00", FrCulture)</td></tr>
            </table>

            @* Aperçu 10 premières lignes *@
            <h4 class="bii-h4">Aperçu — 10 premières lignes</h4>
            <div class="bii-tablewrap">
                <table class="bii-table bii-table--sm">
                    <thead>
                        <tr>
                            <th>Statut</th>
                            <th>Matricule</th>
                            <th>Nom</th>
                            <th>Fonction</th>
                            <th>Site</th>
                            <th class="num">Brut</th>
                            <th class="num">TTC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _preview.Lignes.Take(10))
                        {
                            <tr>
                                <td>@StatutBadge(l.Statut)</td>
                                <td>@l.MatriculeOriginal</td>
                                <td>@l.Nom @l.Prenom</td>
                                <td>@l.Fonction</td>
                                <td>@l.SiteAffectation</td>
                                <td class="num">@FormatFcfa(l.BrutImposable)</td>
                                <td class="num">@FormatFcfa(l.TTC)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_preview.BatchDejaExistant)
            {
                <div class="bii-overwrite">
                    <label>
                        <input type="checkbox" @bind="_ecraserBatch" />
                        <strong>Écraser le batch existant pour @_preview.Mois.ToString("D2")/@_preview.Annee</strong>
                        — l'ancien lot et ses bulletins seront supprimés avant de commit le nouveau.
                    </label>
                </div>
            }

            <div class="bii-actions">
                <button class="bii-btn bii-btn--secondary" @onclick="@(() => _step = 2)">
                    <i class="bi bi-arrow-left"></i> Précédent (changer fichier)
                </button>
                <button class="bii-btn bii-btn--primary"
                        @onclick="GoToStep4"
                        disabled="@(!_preview.PeutCommiter || (_preview.BatchDejaExistant && !_ecraserBatch))">
                    Confirmer l'import <i class="bi bi-check-circle"></i>
                </button>
            </div>
        </section>
    }

    @* ─────────────────────────────────────────────────────────────
       ÉTAPE 4 — Résultat du commit
       ───────────────────────────────────────────────────────────── *@
    @if (_step == 4 && _result != null)
    {
        <section class="bii-section">
            <h3 class="bii-section__title">Étape 4 — Import effectué ✅</h3>

            <div class="bii-alert bii-alert--success">
                <i class="bi bi-check-circle-fill"></i>
                <strong>L'import a été enregistré.</strong>
                @if (_result.BatchEcrase)
                {
                    <span> Ancien batch écrasé (@_result.NbBulletinsAnciensSupprimes lignes supprimées).</span>
                }
            </div>

            <table class="bii-table">
                <tr><td>Lot d'import (Batch)</td><td><code>@_result.BatchOid</code></td></tr>
                <tr><td>Bulletins créés</td><td>@_result.NbBulletinsCrees</td></tr>
                <tr><td>Fiches Intérimaire créées auto</td><td>@_result.NbInterimairesCreesAuto</td></tr>
                <tr><td>Prestataires</td><td>@_result.NbPrestataires</td></tr>
                <tr class="bii-row--strong"><td><strong>Total TTC</strong></td><td><strong>@FormatFcfa(_result.TotalTTC)</strong></td></tr>
            </table>

            @if (_result.NbInterimairesCreesAuto > 0)
            {
                <div class="bii-alert bii-alert--warn">
                    <strong>⚠️ Action RH à faire :</strong>
                    @_result.NbInterimairesCreesAuto fiche(s) Intérimaire ont été créées automatiquement.
                    Vous devez les compléter (Date naissance, CNI, Adresse, etc.) <strong>et créer
                    leurs contrats</strong> avant le prochain import.
                    <details>
                        <summary>Liste des fiches créées</summary>
                        <ul>
                            @foreach (var n in _result.InterimairesCreesNoms) { <li>@n</li> }
                        </ul>
                    </details>
                </div>
            }

            <div class="bii-actions">
                <button class="bii-btn bii-btn--secondary" @onclick="ResetWizard">
                    <i class="bi bi-arrow-clockwise"></i> Nouvel import
                </button>
                <a class="bii-btn bii-btn--primary" href="/dashboards">
                    Voir le dashboard <i class="bi bi-bar-chart"></i>
                </a>
            </div>
        </section>
    }

</div>

